<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SamplePluginProject>..\..\samples\plugins\SlopGarden.Plugins.Sample.HttpJson\SlopGarden.Plugins.Sample.HttpJson.csproj</SamplePluginProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SlopGarden.Client\SlopGarden.Client.csproj" />
    <ProjectReference Include="..\..\src\SlopGarden.Plugins.Emulator\SlopGarden.Plugins.Emulator.csproj" />
    <ProjectReference Include="..\..\src\SlopGarden.Plugins.Hardware\SlopGarden.Plugins.Hardware.csproj" />
    <ProjectReference Include="..\..\src\SlopGarden.Emulator\SlopGarden.Emulator.csproj" />
    <!-- Built but not referenced: the plugin must only be loadable through the client's plugin loader. -->
    <ProjectReference Include="$(SamplePluginProject)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="StageSamplePlugin" AfterTargets="Build">
    <MSBuild Projects="$(SamplePluginProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_SamplePluginTarget" />
    </MSBuild>
    <Error Condition="'$(_SamplePluginTarget)' == ''" Text="Could not resolve the sample plugin output path." />
    <PropertyGroup>
      <_SamplePluginDir>$([System.IO.Path]::GetDirectoryName($(_SamplePluginTarget)))</_SamplePluginDir>
    </PropertyGroup>
    <ItemGroup>
      <_SamplePluginFiles Include="$(_SamplePluginDir)/*.dll;$(_SamplePluginDir)/*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_SamplePluginFiles)" DestinationFolder="$(OutDir)sample-plugin" SkipUnchangedFiles="true" />
  </Target>

</Project>
