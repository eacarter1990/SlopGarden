# Server image: React app + ASP.NET Core. Applies EF migrations on startup.
FROM node:22-bookworm-slim AS web
WORKDIR /src/src/web
COPY src/web/package.json src/web/package-lock.json ./
RUN npm ci
COPY src/web/ ./
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
COPY --from=web /src/src/SlopGarden.Server/wwwroot src/SlopGarden.Server/wwwroot
RUN dotnet publish src/SlopGarden.Server/SlopGarden.Server.csproj -c Release -o /out -p:SkipWebBuild=true

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out .
ENV ASPNETCORE_URLS=http://+:5080 \
    SlopGarden__DataDirectory=/data \
    SlopGarden__SeedDemo=false
VOLUME /data
EXPOSE 5080
ENTRYPOINT ["dotnet", "SlopGarden.Server.dll"]
